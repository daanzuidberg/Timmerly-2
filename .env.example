# Kopieer naar .env (root) — alle apps en packages lezen deze.
DATABASE_URL=postgres://timmerly:timmerly@localhost:5432/timmerly

# 32+ willekeurige tekens; gebruikt om sessiecookies en tokens te ondertekenen.
SESSION_SECRET=verander-dit-in-een-lange-willekeurige-waarde

# Basis-URL van de site, voor links in e-mails.
APP_URL=http://localhost:3000

# E-mail: "console" logt mails naar de terminal; "smtp" gebruikt SMTP_URL.
MAIL_TRANSPORT=console
SMTP_URL=

# Optioneel: AI-functies (projectomschrijving, zoekintentie). Leeg = uit.
ANTHROPIC_API_KEY=
